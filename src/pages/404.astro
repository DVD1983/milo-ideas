---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada - Milo Ideas" noindex={true}>
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-100 via-white to-gray-50 px-5">
    <div class="text-center max-w-lg">
      <div class="text-8xl font-logo font-extrabold text-gray-300 mb-4" style="font-family: 'Baloo 2', sans-serif;">404</div>
      <h1 class="text-3xl font-bold text-gray-800 mb-3">Página no encontrada</h1>
      <p class="text-gray-500 mb-8">La página que buscás no existe o fue movida.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 bg-black text-white px-8 py-3 rounded-full font-semibold hover:bg-gray-800 transition-all hover:shadow-lg hover:-translate-y-0.5 no-underline">
          <i class="fas fa-home"></i> Volver al inicio
        </a>
        <a href="#productos" class="inline-flex items-center gap-2 bg-gray-100 text-gray-700 px-8 py-3 rounded-full font-semibold hover:bg-gray-200 transition-all no-underline">
          <i class="fas fa-th-large"></i> Ver catálogo
        </a>
      </div>
    </div>
  </div>
</Layout>
