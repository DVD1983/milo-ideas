---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getProductsByCategory, getCategoryBySlug } from '../../lib/storage';

const { categoria } = Astro.params;
const slug = categoria!;
const category = await getCategoryBySlug(slug);
const products = await getProductsByCategory(slug);

if (!category) {
  return Astro.redirect('/');
}
---

<Layout
  title={`${category.name} Mayorista | Milo Ideas - Distribuidor Mascotas`}
  description={`${category.description} Mayorista en Argentina. Consultá precios mayoristas en Milo Ideas.`}
  image={category.image}
>
  <Navbar />

  <section class="mt-[60px] bg-gradient-to-br from-gray-100 via-gray-50 to-gray-100 text-gray-700 px-5 pt-28 pb-16 relative overflow-hidden max-md:mt-[50px] max-md:pt-20 max-md:pb-12">
    <div class="max-w-[1200px] mx-auto px-5 relative">
      <nav class="mb-6 text-sm font-body" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-gray-400">
          <li><a href="/" class="hover:text-black transition-colors no-underline text-gray-400">Inicio</a></li>
          <li><i class="fas fa-chevron-right text-[10px]"></i></li>
          <li><a href="/#productos" class="hover:text-black transition-colors no-underline text-gray-400">Catálogo</a></li>
          <li><i class="fas fa-chevron-right text-[10px]"></i></li>
          <li class="font-semibold product-gold-text">{category.name}</li>
        </ol>
      </nav>
      <h1 class="font-logo text-5xl font-bold text-black max-md:text-3xl">{category.name}</h1>
      <p class="font-body text-lg mt-2 max-md:text-base text-black">{category.description}</p>
    </div>
  </section>

  <section class="py-20 px-5 bg-white max-md:py-12 max-md:px-4">
    <div class="max-w-[1200px] mx-auto px-5">
      {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-md:gap-6">
          {products.map((product) => (
            <div class="rounded-2xl bg-white border border-gray-200 shadow-sm overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-xl flex flex-col">
              <div class="aspect-square overflow-hidden bg-gray-50 flex items-center justify-center p-6 border-b border-gray-100">
                <img src={product.image} alt={product.name} class="w-full h-full object-contain mix-blend-multiply" loading="lazy" />
              </div>
              <div class="p-5 flex flex-col flex-1">
                <h3 class="font-logo text-lg font-bold mb-2 product-gold-text">{product.name}</h3>
                <p class="font-body text-sm text-black leading-relaxed mb-3">{product.description}</p>
                {product.specs.length > 0 && (
                  <div class="mb-4">
                    <p class="font-body text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1.5">Ficha técnica</p>
                    <div class="flex flex-wrap gap-1.5">
                      {product.specs.map((spec) => (
                        <span class="inline-block px-2.5 py-1 bg-gray-100 text-gray-700 font-body text-xs font-semibold rounded-full">{spec}</span>
                      ))}
                    </div>
                  </div>
                )}
                <div class="mt-auto flex flex-col items-center gap-3 pt-3 border-t border-gray-100">
                  {product.stock !== undefined && product.stock === 0 && (
                    <p class="text-xs text-red-500 font-semibold">Consultar disponibilidad</p>
                  )}
                  <div class="flex gap-2 w-full">
                    <a
                      href={`https://wa.me/5491131628169?text=${encodeURIComponent('Hola, quiero consultar por: ' + product.name)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-1 flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-white font-body font-bold text-sm shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg no-underline"
                      style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1.5px solid #D4AF37;"
                    >
                      <i class="fab fa-whatsapp text-base wa-icon-gold"></i> <span class="wa-icon-gold">Consultar</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <i class="fas fa-box-open text-5xl mb-4 block cat-gold-icon"></i>
          <p class="font-body text-gray-400 text-lg mb-4">Próximamente más productos</p>
          <a href="/#productos" class="inline-flex items-center gap-2 text-white px-6 py-2.5 rounded-full font-semibold text-sm transition-all no-underline" style="background: linear-gradient(135deg, #B8860B, #FFD700, #D4AF37, #B8860B);">
            <i class="fas fa-arrow-left text-xs"></i> Volver al catálogo
          </a>
        </div>
      )}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://milo-ideas.vercel.app/" },
      { "@type": "ListItem", "position": 2, "name": "Catálogo", "item": "https://milo-ideas.vercel.app/#productos" },
      { "@type": "ListItem", "position": 3, "name": category.name }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `${category.name} - Milo Ideas`,
    "description": category.description,
    "url": `https://milo-ideas.vercel.app/productos/${slug}`,
    "numberOfItems": products.length,
    "itemListElement": products.map((product, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Product",
        "name": product.name,
        "description": product.description,
        "image": product.image,
        "brand": {
          "@type": "Brand",
          "name": "Milo Ideas"
        },
        "offers": {
          "@type": "Offer",
          "availability": product.stock === 0 ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
          "price": "Consultar",
          "priceCurrency": "ARS",
          "seller": {
            "@type": "Organization",
            "name": "Milo Ideas"
          }
        }
      }
    }))
  })} />
</Layout>

<style>
  .wa-icon-gold, .cat-gold-icon, .product-gold-text {
    background: linear-gradient(135deg, #B8860B, #FFD700, #D4AF37, #B8860B);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: pageShimmer 6s ease-in-out infinite;
  }
  @keyframes pageShimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
</style>
