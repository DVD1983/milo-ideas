---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getSlideById } from '../../../../lib/storage';

const id = Astro.params.id;
const slide = id ? await getSlideById(id) : null;

if (!slide) {
  return Astro.redirect('/admin/carousel');
}
---

<AdminLayout title="Editar Slide - Milo Ideas Admin">
  <div class="mb-8">
    <a href="/admin/carousel" class="text-sm text-gray-400 hover:text-black transition-colors">
      <i class="fas fa-arrow-left mr-1"></i> Volver a galería
    </a>
    <h1 class="text-2xl font-bold text-gray-800 mt-2">Editar Slide</h1>
  </div>

  <div class="card max-w-2xl">
    <form id="slideForm" class="flex flex-col gap-5">
      <input type="hidden" id="originalId" value={slide.id} />

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1.5">ID</label>
          <input type="text" value={slide.id} disabled class="input-field bg-gray-50 text-gray-400" />
          <p class="text-xs text-gray-400 mt-1">No se puede cambiar</p>
        </div>
        <div>
          <label for="order" class="block text-sm font-semibold text-gray-600 mb-1.5">Orden</label>
          <input type="number" id="order" name="order" class="input-field" value={slide.order} min="1" />
        </div>
      </div>

      <div>
        <label for="image" class="block text-sm font-semibold text-gray-600 mb-1.5">URL de imagen *</label>
        <input type="text" id="image" name="image" required class="input-field" value={slide.image} />
      </div>

      <div id="imagePreview">
        <img src={slide.image} alt="Preview" class="w-full h-48 object-contain rounded-xl bg-gray-100" />
      </div>

      <div>
        <label for="title" class="block text-sm font-semibold text-gray-600 mb-1.5">Título *</label>
        <input type="text" id="title" name="title" required class="input-field" value={slide.title} />
      </div>

      <div>
        <label for="subtitle" class="block text-sm font-semibold text-gray-600 mb-1.5">Subtítulo</label>
        <input type="text" id="subtitle" name="subtitle" class="input-field" value={slide.subtitle} />
      </div>

      <p id="errorMsg" class="text-red-500 text-sm hidden"></p>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="btn-primary">Guardar cambios</button>
        <a href="/admin/carousel" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>

  <script>
    const imageInput = document.getElementById('image');
    const preview = document.getElementById('imagePreview');
    const previewImg = preview.querySelector('img');

    imageInput.addEventListener('input', () => {
      const url = imageInput.value.trim();
      if (url) {
        previewImg.src = url;
        preview.classList.remove('hidden');
      } else {
        preview.classList.add('hidden');
      }
    });

    document.getElementById('slideForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorMsg = document.getElementById('errorMsg');
      errorMsg.classList.add('hidden');
      const originalId = document.getElementById('originalId').value;

      const data = {
        image: document.getElementById('image').value.trim(),
        title: document.getElementById('title').value.trim(),
        subtitle: document.getElementById('subtitle').value.trim(),
        order: parseInt(document.getElementById('order').value) || 1,
      };

      try {
        const res = await fetch(`/api/carousel/${originalId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          showToast('Slide actualizado', 'success');
          setTimeout(() => window.location.href = '/admin/carousel', 500);
        } else {
          const err = await res.json();
          errorMsg.textContent = err.error || 'Error al actualizar';
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorMsg.textContent = 'Error de conexión';
        errorMsg.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
