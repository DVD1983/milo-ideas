# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-random-password>

# Session signing (independent from admin password, 32+ bytes random)
SESSION_SECRET=<strong-random-secret-string>

# Vercel KV (auto-provisioned on Vercel, but needed if deploying manually)
KV_REST_API_URL=https://<your-kv-id>.kv.vercel-storage.com
KV_REST_API_TOKEN=<your-kv-token>
